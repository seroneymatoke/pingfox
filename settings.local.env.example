# Copy to settings.local.env, fill in secrets, then run:
# source ./scripts/load-env.sh local

export APP_ENV="local"
export DATABASE_URL="sqlite:///pingfox.db"
export PINGFOX_SECRET_KEY="replace-with-a-long-random-local-secret"
export PINGFOX_COOKIE_SECURE="false"
export PINGFOX_APP_URL="http://127.0.0.1:5173"

# Gmail SMTP used for local verification/invoice email tests.
export PINGFOX_GMAIL_ADDRESS="your-gmail-address@gmail.com"
export PINGFOX_GMAIL_PASSWORD="your-gmail-app-password"

# Google OAuth callback registered for local development.
export GOOGLE_CLIENT_ID="your-google-client-id"
export GOOGLE_CLIENT_SECRET="your-google-client-secret"
export GOOGLE_OAUTH_REDIRECT_URI="http://127.0.0.1:5173/api/oauth/google/callback"

# Local admin/demo controls.
export PINGFOX_ADMIN_EMAILS="mseroney88@gmail.com"
export PINGFOX_SUPER_ADMIN_EMAIL="mseroney88@gmail.com"
export PINGFOX_SEED_DEMO_DATA="true"

# Leave blank until Stripe billing is implemented.
export STRIPE_SECRET_KEY=""
