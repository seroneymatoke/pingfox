# Production values are normally entered in Vercel Project Settings rather than sourced locally.
# Copy to settings.production.env only for a controlled production-like shell.
# source ./scripts/load-env.sh production

export APP_ENV="production"
export DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"
export PINGFOX_SECRET_KEY="replace-with-a-long-random-production-secret"
export PINGFOX_COOKIE_SECURE="true"
export PINGFOX_APP_URL="https://pingfox.com"

export PINGFOX_GMAIL_ADDRESS="your-production-sender@gmail.com"
export PINGFOX_GMAIL_PASSWORD="your-production-gmail-app-password"

export GOOGLE_CLIENT_ID="your-production-google-client-id"
export GOOGLE_CLIENT_SECRET="your-production-google-client-secret"
export GOOGLE_OAUTH_REDIRECT_URI="https://pingfox.com/api/oauth/google/callback"

export PINGFOX_ADMIN_EMAILS="mseroney88@gmail.com"
export PINGFOX_SUPER_ADMIN_EMAIL="mseroney88@gmail.com"
export PINGFOX_SEED_DEMO_DATA="false"
export STRIPE_SECRET_KEY=""
